the list into its members\nfor k in d.keys():\n    globals()[k] = Relation()\n    facts(globals()[k],*d[k])\n","key":"YDAE863nB2"},{"type":"outputs","id":"9wV9NAnZ6IXv3Ms_qIIbw","children":[],"key":"FIuEJQ3Mtd"}],"key":"YaKtP635TA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Querying the graph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"SCn9kSrmEP"}],"identifier":"querying-the-graph","label":"Querying the graph","html_id":"querying-the-graph","implicit":true,"key":"MksmJf4SRs"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now we have the graph, we can write some queries to extract information from it. Let’s start with a simple query - find all the students on a programme.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TEbQvwTpAG"}],"key":"OZs5XuUS9W"}],"key":"qBRZvk38zW"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Placeholder for code\nx = var()\nrun(0, x, is_enrolled_in(x,\"MSc Cyber Security\"))","key":"ReFKCG32gf"},{"type":"outputs","id":"fwakvlJfA1lDAwbxenbU3","children":[],"key":"Fe39adGjoE"}],"key":"quTy0mPuoF"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now let’s find all the the students who take a particular module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"V3BZzOeZYa"}],"key":"U3liS8VAfP"}],"key":"WSksHLK3Tf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"y = var()\nrun(0, x, is_enrolled_in(x,y), has_module(y, \"Machine Learning\"))","key":"tKDfs7O4zj"},{"type":"outpu