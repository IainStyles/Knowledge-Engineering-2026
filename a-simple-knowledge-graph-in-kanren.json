y of global variables.\n# We then pass the list of facts in using * to unpack the list into its members\nfor k in d.keys():\n    globals()[k] = Relation()\n    facts(globals()[k],*d[k])\n","key":"HI4lSrUSPn"},{"type":"outputs","id":"uGNf-IdxQsELNyhyETXtf","children":[],"key":"PO3DI2W3df"}],"key":"E6zatxZPWY"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Querying the graph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"RuzxMYJ8SF"}],"identifier":"querying-the-graph","label":"Querying the graph","html_id":"querying-the-graph","implicit":true,"key":"pnL6WfW868"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now we have the graph, we can write some queries to extract information from it. Let’s start with a simple query - find all the students on a programme.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"POpG3dze2R"}],"key":"lFvsAsZdKq"}],"key":"N1muyCsSF1"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Placeholder for code\nx = var()\nrun(0, x, is_enrolled_in(x,\"MSc Cyber Security\"))","key":"gxcn1cppb0"},{"type":"outputs","id":"MUVadyX1E3VQBKxNO0bqu","children":[],"key":"sbsIPAjQ4y"}],"key":"HztpVDOWkH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now let’s find all the the students who take a particular module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"lGekKsBKJC"}],"key":"YpvFzaL5zQ"}],"key":"vpWoFXjp6H"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"y = var()\nrun(0, x, is_enrolled_in(