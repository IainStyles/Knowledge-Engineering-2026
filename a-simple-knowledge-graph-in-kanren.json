 list into its members\nfor k in d.keys():\n    globals()[k] = Relation()\n    facts(globals()[k],*d[k])\n","key":"GEvGFQA01a"},{"type":"outputs","id":"2N2VGvp-YyAt_s1llp6BV","children":[],"key":"oWcLBetl70"}],"key":"u6YW0Pxyms"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Querying the graph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xjoaqOQJby"}],"identifier":"querying-the-graph","label":"Querying the graph","html_id":"querying-the-graph","implicit":true,"key":"H3eyUpbMXQ"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now we have the graph, we can write some queries to extract information from it. Let’s start with a simple query - find all the students on a programme.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"hgHLWIBGg2"}],"key":"PLihf2ngac"}],"key":"tDyE2GgrSG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Placeholder for code\nx = var()\nrun(0, x, is_enrolled_in(x,\"MSc Cyber Security\"))","key":"Ulp3eHz53Q"},{"type":"outputs","id":"b2Y0UZy4QOFzw1ArD3x7_","children":[],"key":"gw9vl4mzLE"}],"key":"ItMXUiJcVB"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now let’s find all the the students who take a particular module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"WKHUSjW9pt"}],"key":"zgHBUSZlBz"}],"key":"z0zA0a41GG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"y = var()\nrun(0, x, is_enrolled_in(x,y), has_module(y, \"Machine Learning\"))","key":"VRvDLRaA7j"},{"type":"outputs"