","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s add some facts","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"CcyeVrwAdW"}],"key":"KHjmHsuJKw"}],"key":"pyDJvWXmiG"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"facts(Requires,(\"AI\",\"ECS8050\"),(\"AI\",\"ECS8051\"),(\"AI\",\"ECS8052\"))\nfacts(Enrolled,(\"Alice\",\"AI\"),(\"Bob\",\"AI\"),(\"Chen\",\"AI\"))\nfacts(Teaches,(\"Diana\",\"ECS8050\"),(\"Edward\",\"ECS8051\"),(\"Faye\",\"ECS8052\"))\nf = [(\"Alice\",\"ECS8050\"),(\"Alice\",\"ECS8051\"),(\"Alice\",\"ECS8052\"),(\"Bob\",\"ECS8050\"),(\"Bob\",\"ECS8052\"),(\"Chen\",\"ECS8050\"),(\"Chen\",\"ECS8051\"),(\"Chen\",\"ECS8052\")]\nfacts(Passed, *f)","key":"yGnxRJUwcQ"},{"type":"outputs","id":"k44nULJodWS1hYtXHtHS7","children":[],"key":"R6BWFJcoL6"}],"key":"Mb7bpPh68n"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s run a couple of simple queries over this","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"Q2UT077w5F"}],"key":"GTt0Iajf7G"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Who teaches ECS8051?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"mZrYkKebd7"}],"key":"fF4xVHIhNO"}],"key":"YbHCHqjMKQ"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What modules has Bob passed"