f global variables.\n# We then pass the list of facts in using * to unpack the list into its members\nfor k in d.keys():\n    globals()[k] = Relation()\n    facts(globals()[k],*d[k])\n","key":"eAWLwgpzQP"},{"type":"outputs","id":"MLu8qbc92jygTKMf601xx","children":[],"key":"CvNFa6KVud"}],"key":"Ajw045SuUq"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Querying the graph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"jX1PrbnsCl"}],"identifier":"querying-the-graph","label":"Querying the graph","html_id":"querying-the-graph","implicit":true,"key":"OBe8TI4Zo0"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now we have the graph, we can write some queries to extract information from it. Let’s start with a simple query - find all the students on a programme.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"G8ARX3K3R8"}],"key":"N1bmxRE60C"}],"key":"xAUX86VE7H"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Placeholder for code\nx = var()\nrun(0, x, is_enrolled_in(x,\"MSc Cyber Security\"))","key":"JsfrlVmqjL"},{"type":"outputs","id":"xAo7ZUs-QJcqHYeB1XzmT","children":[],"key":"islrxkYxh6"}],"key":"WiVjuwRBU6"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now let’s find all the the students who take a particular module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"zc6aZmGj2p"}],"key":"aPAIU8KhWK"}],"key":"KFl4Pe8iNC"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"y = var()\nrun(0, x, is_enrolled_in(x,y