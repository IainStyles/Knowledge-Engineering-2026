","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s add some facts","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"ZqPLGODkTr"}],"key":"ym0L9CWGF5"}],"key":"G0ImTA0V6J"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"facts(Requires,(\"AI\",\"ECS8050\"),(\"AI\",\"ECS8051\"),(\"AI\",\"ECS8052\"))\nfacts(Enrolled,(\"Alice\",\"AI\"),(\"Bob\",\"AI\"),(\"Chen\",\"AI\"))\nfacts(Teaches,(\"Diana\",\"ECS8050\"),(\"Edward\",\"ECS8051\"),(\"Faye\",\"ECS8052\"))\nf = [(\"Alice\",\"ECS8050\"),(\"Alice\",\"ECS8051\"),(\"Alice\",\"ECS8052\"),(\"Bob\",\"ECS8050\"),(\"Bob\",\"ECS8052\"),(\"Chen\",\"ECS8050\"),(\"Chen\",\"ECS8051\"),(\"Chen\",\"ECS8052\")]\nfacts(Passed, *f)","key":"KPOwSVMbIV"},{"type":"outputs","id":"HecuE6-D4iTxipQdskU2X","children":[],"key":"j5b029Mubh"}],"key":"iaApwZO10V"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s run a couple of simple queries over this","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"xsSkXo72KL"}],"key":"kIt4pypMop"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Who teaches ECS8051?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"fQHDQ4s02z"}],"key":"jwN3A2KyZC"}],"key":"kE505zo8rW"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What modules has Bob passed"