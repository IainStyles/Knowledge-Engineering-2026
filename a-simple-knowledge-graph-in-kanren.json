y of global variables.\n# We then pass the list of facts in using * to unpack the list into its members\nfor k in d.keys():\n    globals()[k] = Relation()\n    facts(globals()[k],*d[k])\n","key":"xCwxwm1n2I"},{"type":"outputs","id":"cCa6CGoUTR4Y2z8hZVOhA","children":[],"key":"YwCbjGEdUb"}],"key":"xtoO811WcR"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":2,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Querying the graph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"wM3XjqtLKt"}],"identifier":"querying-the-graph","label":"Querying the graph","html_id":"querying-the-graph","implicit":true,"key":"oZfnepIoRr"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Now we have the graph, we can write some queries to extract information from it. Let’s start with a simple query - find all the students on a programme.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"plVEO70wyE"}],"key":"qngh72IAdK"}],"key":"ThDQjZw1gk"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"# Placeholder for code\nx = var()\nrun(0, x, is_enrolled_in(x,\"MSc Cyber Security\"))","key":"nkLS5vh4Yw"},{"type":"outputs","id":"lhY4Lw_da3xPy7iKjO1wl","children":[],"key":"KrOCD8celz"}],"key":"IKunNuLhbZ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Now let’s find all the the students who take a particular module","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"rIcVMrQNEl"}],"key":"xpuEB2nLJJ"}],"key":"siwGMhELez"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"y = var()\nrun(0, x, is_enrolled_in(