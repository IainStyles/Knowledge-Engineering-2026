kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s add some facts","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"HbnRGWB6KS"}],"key":"eGpsT2XheY"}],"key":"ATk65XAMiA"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"facts(Requires,(\"AI\",\"ECS8050\"),(\"AI\",\"ECS8051\"),(\"AI\",\"ECS8052\"))\nfacts(Enrolled,(\"Alice\",\"AI\"),(\"Bob\",\"AI\"),(\"Chen\",\"AI\"))\nfacts(Teaches,(\"Diana\",\"ECS8050\"),(\"Edward\",\"ECS8051\"),(\"Faye\",\"ECS8052\"))\nf = [(\"Alice\",\"ECS8050\"),(\"Alice\",\"ECS8051\"),(\"Alice\",\"ECS8052\"),(\"Bob\",\"ECS8050\"),(\"Bob\",\"ECS8052\"),(\"Chen\",\"ECS8050\"),(\"Chen\",\"ECS8051\"),(\"Chen\",\"ECS8052\")]\nfacts(Passed, *f)","key":"f5tZHrYYkt"},{"type":"outputs","id":"5EN8BRvzDUJ-VeX3ayH43","children":[],"key":"rP0vLxTfBF"}],"key":"iLQeI35vYH"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Let’s run a couple of simple queries over this","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"M8ZfXbeC5j"}],"key":"ZGCEko15Ie"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":2,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Who teaches ECS8051?","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"AYMi9OxFBh"}],"key":"UOkNlUjadx"}],"key":"F36Sj6iOq5"},{"type":"listItem","spread":true,"position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"What modules has Bob passed","p